# LLM Provider Configuration ("ollama" or "claude")
FLEXION_LLM_PROVIDER=ollama

# Ollama local configuration (used when FLEXION_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Anthropic Claude configuration (used when FLEXION_LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# CORS Security (Comma-separated allowed origin URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://flexion.vercel.app

# Server Port (assigned by Railway / Render in production)
PORT=8000
